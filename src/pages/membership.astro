---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Membership" description="Anyone who agrees with the activities, policies and ideals of Ummah Care Foundation can become a Lifetime or Donor Member.">
  <PageHero crumb="Membership" />

  <section class="member">
    <div class="member__inner">
      <div data-reveal="0">
        <h2 class="h2">I want to be a member</h2>
        <p class="lead member__lead">Anyone who agrees with the activities, policies and ideals of Ummah Care Foundation can become a Lifetime and Donor Member.</p>
      </div>

      <div class="member__cards" data-reveal="100">
        <div class="panel member__card">
          <h4 class="h4">Lifetime Member</h4>
          <p class="lead member__cardText">All members who donate at least 100,000 / = (One Lakh) or more to the foundation’s fund for the foundation will become lifetime members of the foundation.</p>
        </div>
        <div class="panel member__card">
          <h4 class="h4">Donor Member</h4>
          <p class="lead member__cardText">All members who donate at least 50,000 / = (fifty thousand) or more to the foundation’s fund for the foundation, will be the donor members of the foundation.</p>
        </div>
      </div>

      <div class="member__form" data-reveal="160">
        <div class="notice" data-form-sent="membership" hidden tabindex="-1">
          <span class="notice__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg></span>
          <p>Thank you — we have received your membership request.</p>
        </div>
        <form class="form" data-form="membership">
          <div class="field-grid member__grid">
            <div class="field"><label class="label" for="mb-name">Your name <em>*</em></label><input id="mb-name" class="input" type="text" required placeholder="Full name" /></div>
            <div class="field"><label class="label" for="mb-email">Email address <em>*</em></label><input id="mb-email" class="input" type="email" required placeholder="you@example.com" /></div>
          </div>
          <div class="field"><label class="label" for="mb-message">Anything else you would like us to know?</label><textarea id="mb-message" class="textarea" placeholder="Your message"></textarea></div>
          <div><button type="submit" class="btn btn--teal btn-fx">Submit request<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7" /></svg></button></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .member { background: #fff; }
  .member__inner { max-width: 1000px; margin: 0 auto; padding: 88px 24px 104px; }
  .member__lead { margin-top: 20px; font-size: 18px; }
  .member__cards { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 22px; }
  .member__card { padding: 40px 36px; }
  .member__cardText { margin-top: 16px; font-size: 15.5px; }
  .member__form { margin-top: 56px; }
  .member__grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
</style>

<script>
  import '../scripts/forms';
</script>
