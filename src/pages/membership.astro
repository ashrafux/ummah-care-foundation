---
import Base from '../layouts/Base.astro';

// Two tiers, side by side, each with its own Apply button. Apply picks the tier for the
// request form below and scrolls to it. Built only from the site's own type, colours,
// panels, inputs and buttons.
const TIERS = [
  { key: 'Lifetime Member', badge: 'Lifetime', amount: '৳1,00,000', text: 'Donate at least ৳1,00,000 (one lakh) to the foundation’s fund and become a lifetime member of the foundation.', tone: 'mint' },
  { key: 'Donor Member', badge: 'Donor', amount: '৳50,000', text: 'Donate at least ৳50,000 (fifty thousand) to the foundation’s fund and become a donor member of the foundation.', tone: 'soft' }
];
const PERKS = ['Open to anyone who shares our ideals', 'Gift goes to the foundation’s fund'];
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 5l7 7-7 7" /></svg>';
const check = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg>';
---
<Base title="Membership" description="Anyone who agrees with the activities, policies and ideals of Ummah Care Foundation can become a Lifetime or Donor Member.">
  <section class="member">
    <div class="member__inner">
      <header class="member__head" data-reveal="0">
        <h1 class="h2 member__title">Become a member</h1>
        <p class="lead member__lead">Anyone who agrees with the activities, policies and ideals of Ummah Care Foundation can become a Lifetime or Donor Member.</p>
      </header>

      <div class="member__cards" data-reveal="100">
        {TIERS.map((t, i) => (
          <article class:list={['tier', `tier--${t.tone}`]}>
            <span class="tier__badge">{t.badge}</span>
            <p class="tier__amount">{t.amount}<small>+ once</small></p>
            <p class="tier__text">{t.text}</p>
            <ul class="tier__perks">
              {PERKS.map((p) => <li><span set:html={check} />{p}</li>)}
            </ul>
            <a href="#member-form" class:list={['btn', i === 0 ? 'btn--teal btn-fx' : 'btn--outline', 'tier__btn']} data-apply={t.key}>
              {i === 0
                ? <Fragment><span class="roll"><span>Apply as {t.badge}</span></span><span class="roll-ico" aria-hidden="true"><i set:html={arrow} /><i set:html={arrow} /></span></Fragment>
                : <Fragment>Apply as {t.badge}</Fragment>}
            </a>
          </article>
        ))}
      </div>

      <div class="member__form" id="member-form" data-reveal="160">
        <div class="notice" data-form-sent="membership" hidden tabindex="-1">
          <span class="notice__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg></span>
          <p>Thank you — we have received your membership request.</p>
        </div>
        <form class="form" data-form="membership">
          <input type="hidden" name="membership" value="Lifetime Member" data-member-type />
          <p class="member__applying">Applying as <b data-member-out>Lifetime Member</b></p>
          <div class="field-grid member__grid">
            <div class="field"><label class="label" for="mb-name">Your name <em>*</em></label><input id="mb-name" class="input" type="text" required autocomplete="name" placeholder="Full name" /></div>
            <div class="field"><label class="label" for="mb-email">Email address <em>*</em></label><input id="mb-email" class="input" type="email" required autocomplete="email" placeholder="you@example.com" /></div>
          </div>
          <div class="field"><label class="label" for="mb-message">Anything else you would like us to know?</label><textarea id="mb-message" class="textarea" placeholder="Your message"></textarea></div>
          <div><button type="submit" class="btn btn--teal btn-fx"><span class="roll"><span>Submit request</span></span><span class="roll-ico" aria-hidden="true"><i set:html={arrow} /><i set:html={arrow} /></span></button></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .member { background: #fff; }
  .member__inner { max-width: calc(952px + 2 * var(--gutter)); margin: 0 auto; padding: calc(92px + 144px) var(--gutter) 144px; }
  .member__head { text-align: center; }
  .member__lead { margin: 18px auto 0; max-width: 640px; }

  .member__cards { margin-top: 52px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .tier { display: flex; flex-direction: column; gap: 16px; padding: 36px 34px; border-radius: 20px; border: 1px solid var(--line); }
  .tier--mint { background: var(--bg-mint); }
  .tier--soft { background: var(--bg-soft-2); border-color: var(--line-3); }
  .tier__badge { align-self: flex-start; padding: 7px 12px; border-radius: 999px; background: var(--teal); color: #fff; font: 700 12px/1 var(--font); letter-spacing: .12em; text-transform: uppercase; }
  .tier--soft .tier__badge { background: var(--ink); }
  .tier__amount { margin: 6px 0 0; font: 700 44px/1 var(--font); letter-spacing: -.035em; color: var(--ink); }
  .tier__amount small { margin-left: 8px; font: 500 16px/1 var(--font); letter-spacing: 0; color: var(--muted); }
  .tier__text { margin: 0; font: 400 17px/1.65 var(--font); color: var(--grey-2); text-wrap: balance; }
  .tier__perks { margin: 2px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font: 500 15.5px/1.4 var(--font); color: var(--ink); }
  .tier__perks li { display: flex; gap: 10px; align-items: center; }
  .tier__perks span { display: grid; color: var(--teal); }
  /* Sized to the label, not the card: left-aligned, the same width as the Contact Submit button. */
  .tier__btn { margin-top: auto; align-self: flex-start; min-width: 220px; justify-content: center; }
  .tier__btn.btn-fx { justify-content: space-between; padding-left: 32px; }

  .member__form { margin-top: 56px; scroll-margin-top: 32px; }
  .member__applying { margin: 0; font: 500 15px/1 var(--font); color: var(--muted); }
  .member__applying b { color: var(--teal-deep); }
  .member__grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  @media (max-width: 900px) {
    .member__inner { padding: 140px var(--gutter) 96px; }
    .member__cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .tier { padding: 28px 22px; }
    .tier__amount { font-size: 36px; }
  }
</style>

<script>
  import '../scripts/forms';

  // "Apply as …" picks the tier for the request form, then the link scrolls down to it.
  const typeIn = document.querySelector<HTMLInputElement>('[data-member-type]');
  const typeOut = document.querySelector<HTMLElement>('[data-member-out]');
  document.querySelectorAll<HTMLElement>('[data-apply]').forEach((a) => a.addEventListener('click', () => {
    if (typeIn) typeIn.value = a.dataset.apply!;
    if (typeOut) typeOut.textContent = a.dataset.apply!;
    window.setTimeout(() => document.getElementById('mb-name')?.focus({ preventScroll: true }), 400);
  }));
</script>
