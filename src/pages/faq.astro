---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const A1 = 'Cras eget leo in quam euismod viverra et luctus tellus. Nullam porta euismod est sodales cursus. In lacinia, mauris quis volutpat tempor, nulla turpis vulputate magna, ut elementum turpis leo vel libero.';
const A2 = 'Ut in vestibulum risus, ut tincidunt sem. Morbi molestie egestas felis, consequat mattis magna suscipit non. Proin ex enim, faucibus sit amet odio vestibulum, condimentum egestas libero.';

const SECTIONS = [
  {
    id: 'section1', title: 'Mission and projects:', pill: 'Mission and projects',
    intro: "Learn about our NGO's mission, projects, volunteer opportunities, donation options, ongoing initiatives, and ways to stay connected.",
    items: [
      ['1. What is the main mission of your NGO?', A1],
      ['2. Can I volunteer or intern with your organization?', A2],
      ['3. How can I donate to support your projects?', A1],
      ['4. What specific projects is your NGO currently working on?', A2],
      ["5. How can I stay updated on your NGO's progress and events?", A1]
    ]
  },
  {
    id: 'section2', title: 'Programs and services:', pill: 'Programs and services',
    intro: 'Explore the diverse programs, services, educational opportunities, community support, events, and advocacy initiatives offered by our NGO.',
    items: [
      ['1. What programs and services does your NGO offer?', A1],
      ['2. How can I benefit from your educational programs?', A2],
      ['3. Do you provide support services for specific communities?', A1],
      ['4. Are there any upcoming events or workshops?', A2],
      ['5. How can I participate in advocacy efforts led by your NGO?', A1]
    ]
  },
  {
    id: 'section3', title: 'Accountability:', pill: 'Accountability',
    intro: 'Discover the tangible impact of our NGO, our commitment to transparency, financial accountability, success stories, and avenues for feedback and reporting.',
    items: [
      ['1. Can I view financial reports or audits?', A1],
      ['2. What impact has your NGO made in the community?', A1],
      ['3. How does your organization ensure transparency and accountability?', A2],
      ['4. What are the success stories or testimonials from beneficiaries?', A2],
      ["5. How can I provide feedback or report concerns about your NGO's operations?", A1]
    ]
  }
];
let n = 0;
---
<Base title="FAQ" description="Frequently asked questions about Ummah Care Foundation's mission, programs and accountability.">
  <PageHero crumb="FAQ" title="Got questions? This way." />

  <section class="faq">
    <div class="faq__inner">
      <div class="faq__pills">
        {SECTIONS.map((s) => <a href={`#${s.id}`} class="faq__pill btn-fx">{s.pill}</a>)}
      </div>

      <div class="faq__sections" data-accordion>
        {SECTIONS.map((s) => (
          <div id={s.id} class="faq__section">
            <h4 class="faq__h4">{s.title}</h4>
            <p class="lead faq__intro">{s.intro}</p>
            <div class="faq__list">
              {s.items.map(([q, a]) => {
                const i = n++;
                const id = `faq-${i}`;
                return (
                  <div class:list={['acc', { 'is-open': i === 0 }]} data-acc-item>
                    <button type="button" class="acc__btn" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={id}>{q}
                      <span class="acc__icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                    </button>
                    <div id={id} data-acc-panel hidden={i !== 0}>
                      <p class="lead acc__answer">{a}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .faq { background: #fff; }
  .faq__inner { max-width: 1000px; margin: 0 auto; padding: 80px 24px 96px; }
  .faq__pills { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .faq__pill { display: inline-flex; align-items: center; height: 48px; padding: 0 24px; border-radius: 999px; border: 1.5px solid #E1EAE6; background: #fff; font: 600 14.5px/1 var(--font); color: #1B1E26; transition: border-color .18s ease, color .18s ease; }
  .faq__pill:hover { border-color: #008F76; color: #008F76; }
  .faq__sections { margin-top: 64px; display: flex; flex-direction: column; gap: 72px; }
  .faq__section { scroll-margin-top: 120px; }
  .faq__h4 { margin: 0; font: 700 22px/1.3 var(--font); letter-spacing: -.025em; color: #1B1E26; }
  .faq__intro { margin-top: 14px; max-width: 760px; }
  .faq__list { margin-top: 32px; display: flex; flex-direction: column; gap: 14px; }
  .acc { border: 1.5px solid #E4EDE9; border-radius: 20px; background: #fff; overflow: hidden; }
  .acc__btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 24px 28px; background: none; border: 0; cursor: pointer; text-align: left; font: 700 17px/1.45 var(--font); color: #1B1E26; }
  .acc__icon { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: #EDF7F4; color: #008F76; transition: transform .22s ease, background .22s ease, color .22s ease; }
  .acc.is-open .acc__icon { background: #008F76; color: #fff; transform: rotate(45deg); }
  .acc__answer { padding: 0 28px 26px; }
</style>

<script>
  import '../scripts/forms';
</script>
