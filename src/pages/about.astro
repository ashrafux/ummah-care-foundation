---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { IMG } from '../data/images';
import { ROUTES, causeHref } from '../data/site';

const PROGRAMS = [
  { href: causeHref('educational-aid'), icon: 'M3 6.5A2.5 2.5 0 0 1 5.5 4H11v15H5.5A2.5 2.5 0 0 0 3 21zM21 6.5A2.5 2.5 0 0 0 18.5 4H13v15h5.5A2.5 2.5 0 0 1 21 21z', title: ['Education', 'for Every Student'], text: 'Monthly scholarships for meritorious students who would otherwise leave school, college or university.' },
  { href: causeHref('self-reliance'), icon: 'M4 20V10l8-6 8 6v10M9 20v-6h6v6', title: ['Self-Reliance', 'for Families'], text: 'Rickshaws, sewing machines, livestock and small capital so a household can earn its own income.' },
  { href: causeHref('medical-care'), icon: 'M12 21s-7-4.6-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.4-7 10-7 10zM8 12h2l1-2 2 4 1-2h2', title: ['Medical Care', 'for the Poor'], text: 'Surgery, medicine and hospital costs for patients whose families cannot afford treatment.' },
  { href: causeHref('food-assistance'), icon: 'M5 8h14l-1 12H6zM8 8V6a4 4 0 0 1 8 0v2', title: ['Food Assistance', 'for Hungry Homes'], text: 'Rice, lentils, oil and essentials delivered to families who cannot afford a full meal.' },
  { href: causeHref('winter-clothes'), icon: 'M12 3v18M3 12h18M6 6l12 12M18 6L6 18', title: ['Winter Clothing', 'for the Cold Months'], text: 'Blankets and warm clothes for the elderly, children and families in northern districts.' },
  { href: causeHref('water-aid'), icon: 'M12 3s6 7 6 11.5A6 6 0 0 1 6 14.5C6 10 12 3 12 3z', title: ['Water Aid', 'for Every Village'], text: 'Tubewells and safe drinking water so children stop falling sick from dirty sources.' },
  { href: causeHref('humanitarian-aid'), icon: 'M4 14l4-4 4 4 4-4 4 4M8 10V6a4 4 0 0 1 8 0v4M4 14v3a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-3', title: ['Humanitarian Aid', 'for Families in Hardship'], text: 'Marriage support, shelter repair and help in the moments a family cannot face alone.' },
  { href: causeHref('emergency-assistance'), icon: 'M12 3l9 16H3zM12 10v4M12 17h.01', title: ['Emergency Assistance', 'in Times of Crisis'], text: 'Rapid food, cash and relief within days when floods, fire or disaster strike.' }
];

const AVATAR_BG = ['#2D6A4F', '#00473B', '#1F3D3B', '#008F76'];
---
<Base title="About" active="About" description="We are a Bangladeshi non-profit that stands beside families in need with education, livelihoods, healthcare and relief.">
  <PageHero crumb="About" />

  <section class="intro">
    <div class="intro__inner">
      <h1 class="intro__title">We are a Bangladeshi non-profit that <span>stands beside</span> families in need with education, livelihoods, healthcare and relief.</h1>
      <div class="intro__grid">
        <div>
          <h3 class="intro__h3">Our Mission</h3>
          <p class="lead intro__p">To serve humanity by reaching the poorest households in Bangladesh with practical, lasting support: scholarships that keep students in school, tools that create income, and care that arrives when it is needed most.</p>
        </div>
        <div>
          <h3 class="intro__h3">Our Vision</h3>
          <p class="lead intro__p">A society where no talented student drops out for lack of money, no family goes hungry in a crisis, and every person can earn a dignified living and give back in turn.</p>
        </div>
        <div>
          <h3 class="intro__h3">Our Values</h3>
          <ul class="values">
            <li>Accountability to every donor</li>
            <li>Transparency in how funds are used</li>
            <li>Dignity for the people we serve</li>
            <li>Long-term impact over one-time relief</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="impact">
    <img src={IMG.foodDistribution} alt="" class="impact__bg" loading="lazy" />
    <div class="impact__shade"></div>
    <div class="impact__inner">
      <p class="eyebrow eyebrow--light">Our Impact</p>
      <h2 class="impact__title">Since 2020 we have worked with families across Bangladesh. Every taka is tracked to the person it reaches.</h2>
      <div class="impact__grid">
        <div class="impact__card impact__card--wide"><p class="impact__num"><span data-count="200">0</span>+</p><p class="impact__label">Students</p></div>
        <div class="impact__card"><p class="impact__num"><span data-count="500">0</span>+</p><p class="impact__label">Families</p></div>
        <div class="impact__card"><p class="impact__num"><span data-count="50">0</span>+</p><p class="impact__label">Patients</p></div>
        <div class="impact__card impact__card--tall"><p class="impact__num"><span data-count="8">0</span></p><p class="impact__label">Districts</p></div>
      </div>
    </div>
  </section>

  <section class="what">
    <div class="what__inner">
      <h2 class="what__title">What We Do</h2>
      <p class="lead what__lead">Our work is organised around eight programs. Each one is designed to solve a specific problem for a specific family, and we stay involved until the change holds.</p>
      <div class="what__grid">
        {PROGRAMS.map((p) => (
          <a href={p.href} class="program">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#008F76" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.icon} /></svg>
            <h3>{p.title[0]}<br />{p.title[1]}</h3>
            <p>{p.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="money">
    <div class="money__inner">
      <div class="money__grid">
        <div class="money__copy">
          <div>
            <p class="eyebrow">Trackable</p>
            <h2 class="money__title">Where the money goes</h2>
            <p class="lead money__lead">We are a volunteer-run foundation. Almost everything you give reaches a student, a patient or a family directly, and we publish how each program spends its share.</p>
          </div>
          <a href={ROUTES.donate} class="btn btn--teal money__btn btn-fx">Donate now<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7" /></svg></a>
        </div>
        <div class="money__chart">
          <div class="donut">
            <div class="donut__hole">
              <span class="donut__value">88%</span>
              <span class="donut__label">to programs</span>
            </div>
          </div>
          <ul class="legend">
            <li><span style="background:#008F76"></span>88% Programs</li>
            <li><span style="background:#95D5B2"></span>8% Operations</li>
            <li><span style="background:#FFF3B0"></span>4% Outreach</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="involve">
    <div class="involve__inner">
      <div class="involve__head">
        <h2 class="involve__title">Want to get involved?<br />Three ways to stand with us.</h2>
        <p class="lead involve__lead">Pick the one that fits you, and we will take it from there.</p>
      </div>
      <div class="involve__grid">
        <div class="inv inv--photo">
          <img src={IMG.students} alt="" class="inv__bg" loading="lazy" />
          <div class="inv__shade"></div>
          <h3 class="inv__h3 inv__h3--light">Give. A one-time or monthly gift funds scholarships, treatment and relief.</h3>
          <a href={ROUTES.donate} class="inv__btn btn-fx">Donate now</a>
        </div>
        <div class="inv">
          <div>
            <h3 class="inv__h3">Sponsor</h3>
            <p class="lead inv__p">Take on a student's monthly scholarship or a family's livelihood and follow their progress.</p>
          </div>
          <div>
            <p class="inv__members">Join over 500 members</p>
            <a href={ROUTES.membership} class="avatars">
              {IMG.avatars.map((src, i) => <img src={src} alt="" style={`background:${AVATAR_BG[i]}`} loading="lazy" />)}
              <span>500+</span>
            </a>
          </div>
        </div>
        <div class="inv">
          <div>
            <p class="inv__count"><span data-count="120">0</span>+</p>
            <p class="inv__members">Active volunteers across Bangladesh</p>
          </div>
          <div>
            <h3 class="inv__h3">Volunteer</h3>
            <p class="lead inv__p">Join distributions, visit beneficiaries and help us verify that every taka reaches its purpose.</p>
            <a href={ROUTES.volunteer} class="inv__link">Join us<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7" /></svg></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { background: #fff; }
  .intro__inner { max-width: 1290px; margin: 0 auto; padding: 24px 24px 104px; }
  .intro__title { margin: 0 auto; font: 700 clamp(40px, 4.8vw, 64px)/1.1 var(--font); letter-spacing: -.035em; color: #1B1E26; text-align: center; max-width: 1000px; text-wrap: balance; }
  .intro__title span { color: #008F76; }
  .intro__grid { margin-top: 192px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 48px 40px; }
  .intro__h3 { margin: 0; font: 700 24px/1.3 var(--font); letter-spacing: -.02em; color: #1B1E26; }
  .intro__p { margin-top: 16px; }
  .values { margin: 16px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .values li { display: flex; align-items: center; gap: 12px; font: 400 16.5px/1.5 var(--font); color: #5E6470; }
  .values li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #008F76; flex: 0 0 auto; }

  .impact { position: relative; overflow: hidden; background: #0D0D0D; }
  .impact__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .22; display: block; filter: grayscale(1); }
  .impact__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 13, 13, .6), rgba(13, 13, 13, .92)); }
  .impact__inner { position: relative; max-width: 1290px; margin: 0 auto; padding: 112px 24px 104px; }
  .impact__title { margin: 20px 0 0; font: 700 clamp(32px, 3.8vw, 52px)/1.15 var(--font); letter-spacing: -.035em; color: #fff; max-width: 900px; text-wrap: balance; }
  .impact__grid { margin-top: 64px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: minmax(300px, auto); gap: 16px; }
  .impact__card { display: flex; flex-direction: column; justify-content: space-between; background: rgba(255, 255, 255, .08); border-radius: 20px; padding: 36px 32px; min-height: 300px; }
  .impact__card--wide { grid-column: 1 / 3; }
  .impact__card--tall { grid-column: 3; grid-row: 1 / 3; }
  .impact__num { margin: 0; font: 700 clamp(56px, 6vw, 88px)/1 var(--font); letter-spacing: -.04em; color: #fff; }
  .impact__label { margin: 0; font: 700 20px/1.3 var(--font); letter-spacing: -.02em; color: #fff; }

  .what { background: #fff; }
  .what__inner { max-width: 1290px; margin: 0 auto; padding: 112px 24px 104px; }
  .what__title { margin: 0; font: 700 40px/1.15 var(--font); letter-spacing: -.03em; color: #1B1E26; }
  .what__lead { margin-top: 20px; max-width: 820px; }
  .what__grid { margin-top: 64px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 48px 32px; }
  .program { display: block; color: inherit; }
  .program svg { display: block; }
  .program h3 { margin: 24px 0 0; font: 700 20px/1.3 var(--font); letter-spacing: -.02em; color: #1B1E26; }
  .program p { margin: 14px 0 0; font: 400 15px/1.7 var(--font); color: #5E6470; text-wrap: pretty; }

  .money { background: #fff; }
  .money__inner { max-width: 1290px; margin: 0 auto; padding: 112px 24px 104px; }
  .money__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  .money__copy { display: flex; flex-direction: column; justify-content: space-between; background: #F7F7F7; border-radius: 20px; padding: 48px 44px; min-height: 440px; }
  .money__title { margin: 20px 0 0; font: 700 clamp(32px, 3.8vw, 52px)/1.15 var(--font); letter-spacing: -.035em; color: #1B1E26; max-width: 900px; text-wrap: balance; }
  .money__lead { margin-top: 24px; max-width: 560px; }
  .money__btn { align-self: flex-start; margin-top: 40px; }
  .money__chart { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 40px; background: #0D0D0D; border-radius: 20px; padding: 48px 32px; min-height: 440px; }
  .donut { width: min(300px, 70vw); aspect-ratio: 1; border-radius: 50%; background: conic-gradient(#008F76 0 88%, #95D5B2 88% 96%, #FFF3B0 96% 100%); display: flex; align-items: center; justify-content: center; }
  .donut__hole { width: 58%; aspect-ratio: 1; border-radius: 50%; background: #0D0D0D; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .donut__value { font: 700 44px/1 var(--font); letter-spacing: -.03em; color: #fff; }
  .donut__label { margin-top: 6px; font: 500 13px/1 var(--font); color: rgba(255, 255, 255, .75); }
  .legend { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 16px; }
  .legend li { display: flex; align-items: center; gap: 12px; font: 500 16px/1.4 var(--font); color: #fff; }
  .legend span { width: 28px; height: 12px; border-radius: 3px; flex: 0 0 auto; }

  .involve { background: #fff; }
  .involve__inner { max-width: 1290px; margin: 0 auto; padding: 112px 24px 104px; }
  .involve__head { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px; align-items: end; }
  .involve__title { margin: 0; font: 700 clamp(32px, 3.8vw, 52px)/1.15 var(--font); letter-spacing: -.035em; color: #1B1E26; text-wrap: balance; }
  .involve__lead { max-width: 440px; }
  .involve__grid { margin-top: 56px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .inv { display: flex; flex-direction: column; justify-content: space-between; border-radius: 20px; background: #F7F7F7; min-height: 560px; padding: 40px 32px; }
  .inv--photo { position: relative; overflow: hidden; background: #1B1E26; justify-content: flex-end; }
  .inv__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .inv__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 13, 13, .45) 0%, rgba(13, 13, 13, .55) 40%, rgba(13, 13, 13, .92) 100%); }
  .inv__h3 { margin: 0; font: 700 clamp(28px, 2.6vw, 36px)/1.15 var(--font); letter-spacing: -.03em; color: #1B1E26; }
  .inv__h3--light { position: relative; color: #fff; text-wrap: balance; }
  .inv__btn { position: relative; display: inline-flex; align-self: flex-start; align-items: center; margin-top: 28px; height: 52px; padding: 0 28px; border-radius: 999px; background: #008F76; color: #fff; font: 700 15px/1 var(--font); transition: background .2s ease, color .2s ease; }
  .inv__btn:hover { background: #fff; color: #1B1E26; }
  .inv__p { margin-top: 18px; }
  .inv__members { margin: 0; font: 600 20px/1.3 var(--font); letter-spacing: -.02em; color: #1B1E26; }
  .inv__count + .inv__members { margin-top: 18px; }
  .avatars { display: flex; align-items: center; margin-top: 18px; color: inherit; }
  .avatars img, .avatars span { width: 64px; height: 64px; border-radius: 50%; border: 3px solid #F7F7F7; display: block; object-fit: cover; }
  .avatars img + img, .avatars span { margin-left: -16px; }
  .avatars span { background: #008F76; display: flex; align-items: center; justify-content: center; font: 700 15px/1 var(--font); color: #fff; }
  .inv__count { margin: 0; font: 700 clamp(44px, 4.4vw, 60px)/1 var(--font); letter-spacing: -.04em; color: #008F76; }
  .inv__link { display: inline-flex; align-items: center; gap: 8px; margin-top: 20px; font: 700 15px/1 var(--font); color: #008F76; }
  .inv__link:hover { color: #1B1E26; }

  @media (max-width: 960px) {
    .involve__head { grid-template-columns: 1fr; }
    .involve__grid { grid-template-columns: 1fr; }
    .inv { min-height: 420px; }
  }
  @media (max-width: 900px) {
    .impact__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
    .impact__card { min-height: 240px; grid-column: auto; grid-row: auto; }
    .impact__card--wide { grid-column: 1 / 3; }
  }
  @media (max-width: 820px) {
    .money__grid { grid-template-columns: 1fr; }
    .money__copy, .money__chart { min-height: 0; }
  }
  @media (max-width: 640px) {
    .intro__grid { margin-top: 96px; }
  }
  @media (max-width: 560px) {
    .impact__grid { grid-template-columns: 1fr; }
    .impact__card--wide { grid-column: auto; }
  }
</style>
