---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { ROUTES } from '../data/site';

const SKILLS = ['First aid', 'Teaching', 'Financial aid', 'Childcare', 'Human rights', 'Other'];
---
<Base title="Volunteer" description="Give your time. Change a life. Register as a volunteer with Ummah Care Foundation.">
  <PageHero crumb="Volunteer" title="Give your time. Change a life." />

  <section class="vol">
    <div class="vol__form" data-reveal="0">
      <div class="notice" data-form-sent="volunteer" hidden tabindex="-1">
        <span class="notice__icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5" /></svg></span>
        <p>Thanks for registering — our team will be in touch soon.</p>
      </div>
      <form class="form vol__fields" data-form="volunteer">
        <div>
          <h5 class="vol__h5">Contact details</h5>
          <div class="form">
            <div class="field"><label class="label" for="vl-name">Your name <em>*</em></label><input id="vl-name" class="input" type="text" required placeholder="Full name" /></div>
            <div class="field-grid vol__grid">
              <div class="field"><label class="label" for="vl-phone">Phone number <em>*</em></label><input id="vl-phone" class="input" type="tel" required placeholder="+8801XXXXXXXXX" /></div>
              <div class="field"><label class="label" for="vl-email">Email address <em>*</em></label><input id="vl-email" class="input" type="email" required placeholder="you@example.com" /></div>
            </div>
          </div>
        </div>
        <div>
          <h5 class="vol__h5">Skillsets or area of interests</h5>
          <div class="skills" data-toggle-group="multi">
            {SKILLS.map((s) => <button type="button" class="skill">{s}</button>)}
          </div>
        </div>
        <div>
          <h5 class="vol__h5">Additional information (optional)</h5>
          <textarea class="textarea" placeholder="Anything else you would like us to know?" aria-label="Additional information"></textarea>
        </div>
        <label class="check">
          <input type="checkbox" required />
          <span>I understand and agree to the <a href={ROUTES.privacy}>privacy policy</a>.</span>
        </label>
        <div><button type="submit" class="btn btn--teal btn-fx">Register as volunteer<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7" /></svg></button></div>
      </form>
    </div>

    <div class="vol__ctaWrap">
      <div class="panel vol__cta" data-reveal="0">
        <p class="kicker">Get involved</p>
        <h2 class="h2 vol__ctaTitle">Join thousands of others across the country</h2>
        <p class="lead vol__ctaLead">Giving your time means helping to give those most vulnerable a chance at the future they deserve.</p>
        <div class="vol__ctaBtn"><a href={ROUTES.membership} class="btn btn--teal btn-fx">Get started now<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7" /></svg></a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .vol { background: #fff; }
  .vol__form { max-width: 820px; margin: 0 auto; padding: 88px 24px 0; }
  .vol__fields { gap: 44px; }
  .vol__h5 { margin: 0 0 24px; font: 700 17px/1.3 var(--font); letter-spacing: -.02em; color: #1B1E26; }
  .vol__grid { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .skills { display: flex; flex-wrap: wrap; gap: 12px; }
  .skill { display: flex; align-items: center; height: 48px; padding: 0 22px; border-radius: 999px; cursor: pointer; font-weight: 600; font-size: 14.5px; transition: all .18s ease; border: 1.5px solid #E1EAE6; background: #fff; color: #3A3F4B; }
  .skill.is-on { border-color: #008F76; background: #008F76; color: #fff; }
  .vol__ctaWrap { max-width: 1290px; margin: 0 auto; padding: 96px 24px 104px; }
  .vol__cta { padding: 76px 56px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .vol__ctaTitle { font-size: 44px; margin-top: 18px; max-width: 720px; }
  .vol__ctaLead { margin-top: 20px; max-width: 620px; }
  .vol__ctaBtn { margin-top: 34px; }
  @media (max-width: 640px) { .vol__cta { padding: 56px 28px; } .vol__ctaTitle { font-size: 34px; } }
</style>

<script>
  import '../scripts/forms';
</script>
