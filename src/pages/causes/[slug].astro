---
import Base from '../../layouts/Base.astro';
import CauseSplit from '../../components/CauseSplit.astro';
import CauseScroll from '../../components/CauseScroll.astro';
import Testimonials from '../../components/Testimonials.astro';
import { CAUSES } from '../../data/causes';

export function getStaticPaths() {
  return CAUSES.map((cause) => ({ params: { slug: cause.slug }, props: { cause } }));
}

const { cause } = Astro.props;
---
<Base title={cause.crumb} active="Causes" description={cause.title}>
  <CauseSplit cause={cause} />
  <CauseScroll data={cause} />
  <Testimonials />
</Base>
