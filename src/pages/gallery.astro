---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { GALLERY } from '../data/gallery';
import { CAUSE_NAV } from '../data/site';

const countFor = (slug: string) => GALLERY.filter((s) => s.cause === slug).length;
const CATEGORIES = [
  { slug: 'all', name: 'All photos', count: GALLERY.length },
  ...CAUSE_NAV.map((c) => ({ slug: c.slug, name: c.name, count: countFor(c.slug) }))
];
---
<Base title="Gallery" active="Gallery" description="Photographs from Ummah Care Foundation's work across Bangladesh, sorted by cause.">
  <PageHero crumb="Gallery" title="Moments from the field" subtitle="Every photograph here is from a real distribution, handover or visit. Pick a cause to see its work." />

  <section class="gal" data-gallery>
    <div class="gal__inner">
      <aside class="panel gal__side" data-no-reveal>
        <p class="gal__sideLabel">Causes</p>
        <div class="gal__cats" role="group" aria-label="Filter photos by cause">
          {CATEGORIES.map((c) => (
            <button type="button" class:list={['gal__cat', { 'is-on': c.slug === 'all' }]} data-filter={c.slug} aria-pressed={c.slug === 'all' ? 'true' : 'false'}>
              <span class="gal__bar" aria-hidden="true"></span>
              <span class="gal__catName">{c.name}</span>
              <span class="gal__count">{c.count}</span>
            </button>
          ))}
        </div>
      </aside>

      <div class="gal__main">
        <p class="gal__meta"><span data-gallery-count>{GALLERY.length} photos</span></p>
        <div class="gal__grid" data-lightbox="gallery">
          {GALLERY.map((shot) => (
            <figure class="gal__item zoom" data-cause={shot.cause}>
              <img src={shot.src} alt={shot.alt} loading="lazy" />
            </figure>
          ))}
        </div>
        <p class="gal__empty" data-gallery-empty hidden>No photographs in this cause yet.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .gal { background: #fff; }
  .gal__inner { max-width: 1290px; margin: 0 auto; padding: 72px 24px 104px; display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 64px; align-items: start; }

  /* Sidebar of causes, following the contents panel used on the policy pages. */
  .gal__side { position: sticky; top: 120px; padding: 22px 16px; }
  .gal__sideLabel { margin: 0 0 14px 14px; font: 700 12.5px/1 var(--font); letter-spacing: .12em; text-transform: uppercase; color: var(--teal); }
  .gal__cats { display: flex; flex-direction: column; gap: 2px; }
  .gal__cat { display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 14px; border: 0; border-radius: 14px; background: none; cursor: pointer; text-align: left; font: 600 14.5px/1.4 var(--font); color: var(--grey-3); transition: background .18s ease, color .18s ease; }
  .gal__cat:hover { background: var(--mint-2); color: var(--teal); }
  .gal__cat.is-on { background: var(--mint-2); color: var(--teal); }
  .gal__bar { width: 3px; height: 16px; border-radius: 2px; background: transparent; flex: none; transition: background .18s ease; }
  .gal__cat.is-on .gal__bar { background: var(--teal); }
  .gal__catName { min-width: 0; }
  .gal__count { margin-left: auto; font: 600 12.5px/1 var(--font); color: var(--grey-4); }
  .gal__cat.is-on .gal__count { color: var(--teal); }

  .gal__main { min-width: 0; }
  .gal__meta { margin: 0 0 18px; font: 500 14px/1 var(--font); color: var(--grey-4); }
  .gal__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .gal__item { margin: 0; border-radius: 20px; aspect-ratio: 16 / 10; background: var(--bg-soft); }
  .gal__empty { margin: 48px 0; text-align: center; font: 400 16.5px/1.75 var(--font); color: var(--muted); }

  @media (max-width: 1019px) {
    .gal__inner { display: flex; flex-direction: column; gap: 32px; padding-top: 56px; }
    /* On narrow screens the sidebar becomes the pill row used on the FAQ page. */
    .gal__side { position: static; padding: 0; background: none; border: 0; }
    .gal__sideLabel { margin-left: 0; }
    .gal__cats { flex-direction: row; flex-wrap: wrap; gap: 10px; }
    .gal__cat { width: auto; height: 44px; padding: 0 18px; border: 1.5px solid var(--line-2); border-radius: 999px; background: #fff; }
    .gal__cat.is-on { border-color: var(--teal); }
    .gal__bar { display: none; }
  }
  @media (max-width: 620px) {
    .gal__grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import '../scripts/gallery';
</script>
