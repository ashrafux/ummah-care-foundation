---
// Home page: hero, foundation stats, Area of Activity (featured and ongoing causes,
// Who we are, Browse by area) and the volunteer call to action.
import Base from '../layouts/Base.astro';
import HomeCauses from '../components/HomeCauses.astro';
import AboutWork from '../components/AboutWork.astro';
import { IMG } from '../data/images';
import { ROUTES } from '../data/site';

// Hero headline, split per word so each one can be revealed on a stagger.
const HERO_TITLE = 'Committed to human social welfare & progress.';
const HERO_WORDS = HERO_TITLE.split(' ');

// Photos fanned under the hero headline, left to right; the middle one sits on top.
const HERO_FAN = [
  { src: IMG.students, alt: 'A student receiving a gift in the classroom' },
  { src: IMG.sewing, alt: 'A sewing machine handed to a beneficiary' },
  { src: IMG.aoaSelfReliance, alt: 'A young man holding up the 2026 gift package list' },
  { src: IMG.goats, alt: 'A goat handed over in the village courtyard' },
  { src: IMG.medicalHospital, alt: 'A father and his child outside the hospital after treatment' }
];


const STATS: [number, string][] = [[200, 'Students Helping'], [3000, 'Serving Poor People'], [100, 'Self-reliance'], [45, 'Volunteers']];

---
<Base title="Home" active="Home" dark>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__mesh"><mesh-gradient fill colors="#081C15,#2D6A4F,#95D5B2,#FFF3B0" seed="1" scale="1.26" grain="0.042" fallback="#003E33"></mesh-gradient></div>
    <div class="hero__shade"></div>
    <div class="hero__inner">
      <h1 class="hero__title" data-hero-reveal="blur" data-no-reveal>
        {HERO_WORDS.map((word, i) => (
          <>
            <span class="hw">{word}</span>
            {i < HERO_WORDS.length - 1 && <span class="hw-sp">{' '}</span>}
          </>
        ))}
      </h1>
      <p class="hero__sub">Your donation has the power to change lives with impactful projects.</p>
      <div class="hero__ctas">
        <a href={ROUTES.donate} class="hero__cta btn-fx"><span class="roll"><span>Donate now</span></span><span class="roll-ico" aria-hidden="true"><i><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg></i><i><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8" /></svg></i></span></a>
        <a href={ROUTES.areaOfActivity} class="hero__cta2">See our causes</a>
      </div>

      <div class="hfan" data-no-reveal>
        {HERO_FAN.map((ph, i) => (
          <img class="hfan__card" style={`--k:${i - 2};--i:${i}`} src={ph.src} alt={ph.alt} />
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats">
    <div class="stats__inner">
      <div class="stats__copy">
        <h2>We make it easy for anyone to change a life.</h2>
        <p class="stats__lead">We stand beside underprivileged communities in Bangladesh with education support, healthcare, and self-reliance programs that help families overcome poverty.</p>
      </div>
      <div class="stats__grid">
        {STATS.map(([n, label]) => (
          <div class="stat">
            <p class="stat__num"><span data-count={n}>0</span><span class="stat__plus">+</span></p>
            <p class="stat__label">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Area of Activity: featured causes, all areas and recent activity -->
  <HomeCauses>
    <!-- Who we are: the About Us story as cards, between Ongoing causes and Browse by area -->
    <AboutWork />
  </HomeCauses>

  <!-- Volunteer CTA -->
  <section class="vol">
    <div class="vol__glow"></div>
    <div class="vol__inner">
      <div class="fan" data-fan>
        <img src={IMG.students} alt="" class="fan__img fan__img--l" loading="lazy" />
        <img src={IMG.goats} alt="" class="fan__img fan__img--r" loading="lazy" />
        <img src={IMG.sewing} alt="" class="fan__img fan__img--c" loading="lazy" />
      </div>
      <h2>Join as volunteer</h2>
      <p>Join us in making a difference! Volunteer with our charity organization and help bring hope and support to those in need. Your time and skills can create a lasting impact.</p>
      <div class="vol__actions">
        <a href={ROUTES.volunteer} class="vol__btn vol__btn--white btn-fx"><span class="roll"><span>Join us</span></span><span class="roll-ico" aria-hidden="true"><i><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 5l7 7-7 7" /></svg></i><i><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 5l7 7-7 7" /></svg></i></span></a>
        <a href={ROUTES.donate} class="vol__btn vol__btn--outline">Donate
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  /* The hero always fills the screen: svh keeps it steady while mobile browser bars show and hide. */
  .hero { position: relative; overflow: hidden; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; background: radial-gradient(ellipse 80% 60% at 65% 45%, #95D5B2 0%, #2D6A4F 32%, #0B2B22 68%, #0D0D0D 100%); }
  .hero__mesh { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 13, 13, .55) 0%, rgba(0, 62, 51, .1) 30%, rgba(0, 0, 0, 0) 55%); pointer-events: none; }
  /* Spare height is split above the headline and below the buttons, so the text sits centred and the photo fan stays on the bottom edge. */
  .hero__inner { flex: 1 0 auto; width: 100%; max-width: var(--shell); margin: 0 auto; padding: clamp(132px, 18vh, 196px) var(--gutter) 0; position: relative; display: flex; flex-direction: column; align-items: center; }
  .hero__inner > .hero__title { margin-top: auto; }
  .hero__inner > .hero__ctas { margin-bottom: auto; }
  .hero__title { margin: 0; font: 700 clamp(44px, 5.4vw, 72px)/1.08 var(--font); letter-spacing: -.035em; color: #fff; text-align: center; max-width: 1060px; text-wrap: balance; }
  /* Headline reveal. Words are inline-block so they can be transformed; the
     spaces stay plain text, so the line still wraps and balances normally.
     Order matters: the rest state comes first, the variants next, and the
     finished state last with higher specificity so it always wins. */
  .hw-sp { white-space: pre-wrap; }
  .hw { display: inline-block; opacity: 0; will-change: transform, filter, opacity; }

  /* blur: each word resolves out of a soft blur */
  [data-hero-reveal="blur"] .hw { filter: blur(14px); transform: translateY(.18em); transition: opacity .85s ease, filter .85s ease, transform .85s cubic-bezier(.16, 1, .3, 1); }
  /* rise: each word lifts into place */
  [data-hero-reveal="rise"] .hw { transform: translateY(.55em); transition: opacity .7s ease, transform .7s cubic-bezier(.16, 1, .3, 1); }
  /* scale: each word settles down from slightly larger */
  [data-hero-reveal="scale"] .hw { transform: scale(1.14); transition: opacity .7s ease, transform .7s cubic-bezier(.16, 1, .3, 1); }

  [data-hero-reveal] .hw.is-in { opacity: 1; filter: blur(0); transform: none; }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-reveal] .hw { opacity: 1; filter: none; transform: none; transition: none; }
    .hfan__card { animation: none; transition: none; }
  }
  .hero__sub { margin: 30px 0 0; font: 400 19px/1.65 var(--font); color: rgba(255, 255, 255, .78); text-align: center; max-width: 620px; text-wrap: balance; }
  .hero__cta { display: inline-flex; align-items: center; gap: 11px; height: 60px; padding: 0 36px; border-radius: 999px; color: #fff; font: 700 17px/1 var(--font); letter-spacing: -.01em; box-shadow: 0 22px 44px -18px rgba(0, 143, 118, .6); transition: background .2s ease; background: #55B984; }
  .hero__cta:hover { background: #00A98C; color: #fff; }
  .hero__ctas { margin-top: 42px; display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; }
  .hero__cta2 { display: inline-flex; align-items: center; height: 60px; padding: 0 32px; border-radius: 999px; border: 1.5px solid rgba(255, 255, 255, .45); color: #fff; font: 700 17px/1 var(--font); letter-spacing: -.01em; transition: background .2s ease, border-color .2s ease; }
  .hero__cta2:hover { background: rgba(255, 255, 255, .1); border-color: #fff; color: #fff; }
  /* Five photos fanned from a pivot below the hero edge; --k runs -2..2 from left to right. */
  /* Spacing and card size scale with the screen so all five cards stay in view down to tablets. */
  /* Card size and the gap above follow the screen height too, so the whole fan fits on short laptop screens. */
  .hfan { --step: clamp(120px, 14.5vw, 230px); --w: clamp(150px, min(15vw, 22vh), 240px); --h: calc(var(--w) * 4 / 3); position: relative; width: 100%; height: calc(var(--h) + 20px); margin-top: clamp(32px, 5vh, 80px); }
  .hfan__card { position: absolute; left: 50%; bottom: -40px; width: var(--w); height: var(--h); object-fit: cover; border-radius: 20px; border: 6px solid #fff; box-shadow: 0 30px 60px -25px rgba(0, 0, 0, .55); transform-origin: 50% 120%;
    transform: translateX(-50%) translateX(calc(var(--k) * var(--step))) translateY(var(--y, 0px)) rotate(calc(var(--k) * 7deg));
    transition: transform .35s var(--ease-out), box-shadow .35s ease;
    animation: hfanIn .9s var(--ease-out) backwards; animation-delay: calc(var(--i) * 70ms + 450ms); }
  .hfan__card:nth-child(3) { --y: -24px; z-index: 2; }
  .hfan__card:hover { --y: -18px; z-index: 3; box-shadow: 0 40px 70px -25px rgba(0, 0, 0, .6); }
  .hfan__card:nth-child(3):hover { --y: -40px; }
  @keyframes hfanIn { from { opacity: 0; transform: translateX(-50%) translateY(140px) rotate(0deg); } }

  @keyframes dnListIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  /* Chosen fund: tinted row, teal name and tick; its icon stays neutral like the rest. */
  /* Hover and keyboard focus carry the full primary colour. */

  /* ---- Stats ---- */
  .stats { background: #fff; }
  .stats__inner { max-width: var(--shell); margin: 0 auto; padding: 120px var(--gutter); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 64px 96px; align-items: start; }
  .stats__copy { display: flex; flex-direction: column; min-width: 0; }
  .stats__copy h2 { margin: 0; font: 700 clamp(40px, 4.4vw, 56px)/1.1 var(--font); letter-spacing: -.03em; color: #1B1E26; text-align: left; text-wrap: balance; }
  .stats__lead { margin: 40px 0 0; font: 400 18px/1.75 var(--font); color: #5E6470; max-width: 640px; text-wrap: balance; }
  .stats__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; align-self: center; min-width: 0; }
  .stat { display: flex; flex-direction: column; gap: 22px; background: #F7F7F7; border-radius: 20px; padding: 36px 34px 34px; }
  .stat__num { margin: 0; font: 700 64px/1 var(--font); letter-spacing: -.04em; color: #1B1E26; display: flex; align-items: baseline; gap: 3px; }
  .stat__plus { color: #008F76; }
  .stat__label { margin: 0; font: 400 18px/1.4 var(--font); color: #5E6470; }

  /* ---- Volunteer CTA ---- */
  .vol { position: relative; background: #00473B; overflow: hidden; }
  .vol__glow { position: absolute; left: 50%; bottom: -260px; transform: translateX(-50%); width: 1100px; height: 560px; background: radial-gradient(ellipse at 50% 100%, rgba(255, 255, 255, .18), rgba(255, 255, 255, .06) 45%, transparent 70%); pointer-events: none; }
  .vol__inner { max-width: var(--shell); margin: 0 auto; padding: 150px var(--gutter) 120px; position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .fan { position: relative; width: min(460px, 90vw); height: 250px; margin: 0 auto; }
  .fan__img { position: absolute; bottom: 0; object-fit: cover; border-radius: 20px; transform-origin: 50% 100%; opacity: 0; -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent 100%); mask-image: linear-gradient(180deg, #000 60%, transparent 100%); }
  .fan__img--l { left: 0; width: 156px; height: 222px; transform: translateY(120%) rotate(-14deg); transition: transform .9s var(--ease) .1s, opacity .6s ease .1s; }
  .fan__img--r { right: 0; width: 156px; height: 222px; transform: translateY(120%) rotate(14deg); transition: transform .9s var(--ease) .2s, opacity .6s ease .2s; }
  .fan__img--c { left: 50%; width: 180px; height: 250px; transform: translate(-50%, 120%); transition: transform .9s var(--ease), opacity .6s ease; }
  .fan.is-in .fan__img { opacity: 1; }
  .fan.is-in .fan__img--l { transform: translateY(0) rotate(-10deg); }
  .fan.is-in .fan__img--r { transform: translateY(0) rotate(10deg); }
  .fan.is-in .fan__img--c { transform: translate(-50%, 0); }
  .vol h2 { margin: 40px 0 0; font: 700 clamp(40px, 4.4vw, 56px)/1.1 var(--font); letter-spacing: -.03em; color: #fff; max-width: 820px; text-wrap: balance; }
  .vol__inner > p { margin: 26px 0 0; font: 400 18px/1.75 var(--font); color: rgba(255, 255, 255, .88); max-width: 560px; text-wrap: balance; }
  .vol__actions { margin-top: 44px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .vol__btn { display: inline-flex; align-items: center; gap: 12px; height: 56px; padding: 0 40px; border-radius: 999px; font: 600 15.5px/1 var(--font); text-decoration: none; transition: background .2s ease, border-color .2s ease; }
  .vol__btn--white { background: #fff; color: #00473B; }
  .vol__btn--white:hover { background: #E6F4F0; color: #00473B; }
  .vol__btn--outline { border: 1px solid rgba(255, 255, 255, .5); background: transparent; color: #fff; }
  .vol__btn--outline:hover { background: rgba(255, 255, 255, .12); border-color: rgba(255, 255, 255, .8); color: #fff; }

  /* ---- Responsive ---- */
  @media (max-width: 960px) {
    .stats__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero__inner { padding-top: clamp(104px, 14vh, 132px); }
    .hfan { --step: 92px; --w: clamp(112px, 17vh, 150px); margin-top: clamp(24px, 4vh, 56px); }
    .hfan__card { border-width: 4px; bottom: -28px; }
    .hfan__card:nth-child(1), .hfan__card:nth-child(5) { display: none; }
    .hero__ctas > * { flex: 1 1 100%; justify-content: center; }
    .stats__grid { grid-template-columns: 1fr; }
    .stat__num { font-size: 52px; }
  }
  /* Small, short phones (iPhone SE size): buttons side by side and tighter gaps, so the hero still fits one screen. */
  @media (max-width: 640px) and (max-height: 720px) {
    .hero__sub { margin-top: 16px; font-size: 17px; }
    .hero__ctas { margin-top: 24px; gap: 10px; flex-wrap: nowrap; }
    .hero__ctas > * { flex: 1 1 0; height: 52px; padding: 0 12px; gap: 8px; font-size: 15px; white-space: nowrap; }
  }
</style>

<script>
  import '../scripts/mesh-gradient';
  import '../scripts/hero-reveal';
  import '../scripts/home';
</script>
